# ---- Required ----
# Generate with: python3 -c 'import secrets;print(secrets.token_urlsafe(32))'
DASHBOARD_TOKEN=REPLACE_WITH_RANDOM_TOKEN

# Anthropic key for the Claude reviewer. Use a key with a low monthly spend limit set in the Anthropic console.
ANTHROPIC_API_KEY=

# ---- Claude reviewer ----
# required = no key/error/budget hit => trade rejected (recommended)
# optional = without a key, trades are decided by deterministic rules only
# off      = never call Claude
AI_MODE=required
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_MAX_CALLS_PER_DAY=40
CLAUDE_MAX_DAILY_USD=0.50
CLAUDE_INPUT_USD_PER_MTOK=0.10
CLAUDE_OUTPUT_USD_PER_MTOK=0.50
CLAUDE_MIN_CONFIDENCE=0.6

# ---- Automation ----
# Start scanning automatically when the server starts (it also resumes if it was running before a restart)
AUTOSTART=false
SCAN_INTERVAL_SECONDS=300
FAVORITES=BTCUSDT,ETHUSDT,QNTUSDT,BRUSDT
UNIVERSE_TOP_N=12
MIN_QUOTE_VOLUME=5000000
# true = also block every trade because news/unlock/listing feeds are unavailable (original V4 behaviour)
REQUIRE_VERIFIED_EVENT_FEEDS=false

# ---- Paper account (risk limits can only be TIGHTENED below the defaults) ----
STARTING_BALANCE=100
RISK_PER_TRADE=0.005
MAX_DAILY_LOSS=0.02
MAX_DRAWDOWN=0.05
MAX_OPEN_POSITIONS=2
MAX_LEVERAGE=3
TAKER_FEE=0.0006
SLIPPAGE=0.0005

# Never add Bitunix API keys: the app refuses to start if BITUNIX_API_KEY / BITUNIX_SECRET_KEY are set.
